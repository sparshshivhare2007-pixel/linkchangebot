# Telegram API Credentials
API_ID=1234567
API_HASH=your_api_hash_here

# Bot Token
BOT_TOKEN=your_bot_token_here

# Channel Details
CHANNEL_ID=-1001234567890     # Channel ID (negative number)

# Usernames List (comma separated, without @)
USERNAMES=techchannel1,techchannel2,techchannel3,techchannel4,techchannel5

# Delay Settings (in seconds)
DELAY_HOURS=1
DELAY_MINUTES=30
DELAY_SECONDS=0

# Session File Path
SESSION_PATH=session/owner_session.session

# Owner ID (for authentication)
OWNER_ID=123456789
